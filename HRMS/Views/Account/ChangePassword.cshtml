@model HRMS.ViewModels.ChangePasswordViewModel

@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/CSS/change-password.css" rel="stylesheet" />
<div class="change-password-page">

    <div class="change-password-header">
        <div>
            <h2>Đổi mật khẩu</h2>
            <p>Cập nhật mật khẩu đăng nhập tài khoản của bạn</p>
        </div>
    </div>

    <div class="card change-password-card">
        <div class="card-header">
            <i class="fa-solid fa-key me-2"></i>
            Thông tin mật khẩu
        </div>

        <div class="card-body">
            @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { id = "changePasswordForm" }))
            {
                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <div class="col-12">
                        <label class="form-label">Mật khẩu hiện tại</label>
                        <div class="password-input-group">
                            @Html.PasswordFor(m => m.CurrentPassword, new
                            {
                                @class = "form-control",
                                placeholder = "Nhập mật khẩu hiện tại",
                                autocomplete = "current-password"
                            })
                            <button type="button" class="btn-toggle-password" data-target="CurrentPassword">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Mật khẩu mới</label>
                        <div class="password-input-group">
                            @Html.PasswordFor(m => m.NewPassword, new
                            {
                                @class = "form-control",
                                placeholder = "Nhập mật khẩu mới",
                                autocomplete = "new-password"
                            })
                            <button type="button" class="btn-toggle-password" data-target="NewPassword">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Xác nhận mật khẩu mới</label>
                        <div class="password-input-group">
                            @Html.PasswordFor(m => m.ConfirmPassword, new
                            {
                                @class = "form-control",
                                placeholder = "Nhập lại mật khẩu mới",
                                autocomplete = "new-password"
                            })
                            <button type="button" class="btn-toggle-password" data-target="ConfirmPassword">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12">
                        <div class="change-password-actions">
                            <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                                <i class="fa-solid fa-arrow-left me-1"></i>
                                Quay lại
                            </a>

                            <button id="btnChangePassword" type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-floppy-disk me-1"></i>
                                Lưu mật khẩu
                            </button>
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>

</div>

<script>
    $(function () {
        $(".btn-toggle-password").on("click", function () {
            const targetName = $(this).data("target");
            const $input = $(`[name='${targetName}']`);
            const $icon = $(this).find("i");

            const isPassword = $input.attr("type") === "password";
            $input.attr("type", isPassword ? "text" : "password");

            $icon.toggleClass("fa-eye", !isPassword)
                .toggleClass("fa-eye-slash", isPassword);
        });

        $("#changePasswordForm").on("submit", function () {
            const $btn = $("#btnChangePassword");
            $btn.prop("disabled", true)
                .html('<span class="spinner-border spinner-border-sm me-1"></span> Đang lưu...');
        });
    });
</script>
