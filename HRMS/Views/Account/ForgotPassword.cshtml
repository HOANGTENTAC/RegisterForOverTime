@model HRMS.ViewModels.ForgotPasswordViewModel

@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = null;

    var alert = new
    {
        Message = TempData["ToastrMessage"],
        Type = TempData["ToastrType"]
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HRMS - Quên mật khẩu</title>

    <link href="~/Content/fontawesome/css/all.css" rel="stylesheet" />
    <link href="~/Content/toastr.min.css" rel="stylesheet" />
    <link href="~/Content/login.css" rel="stylesheet" />

    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/toastr.min.js"></script>
    <script src="~/Scripts/toastr-message.js"></script>
</head>

<body>
    <div class="bg-animation">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
    </div>

    <div class="login-container">

        <div class="login-left">
            <div class="brand">
                <h1>HRMS</h1>
                <h3>Human Resource Management System</h3>
                <p>
                    Quản lý nhân sự thông minh,
                    tối ưu quy trình tuyển dụng,
                    chấm công và đánh giá nhân viên.
                </p>
            </div>

            <img src="~/Images/logo.png" alt="HRMS Logo" />
        </div>

        <div class="login-right">
            <div class="login-card">

                <div class="logo-circle">
                    <i class="fa-solid fa-unlock-keyhole"></i>
                </div>

                <h2>Quên mật khẩu</h2>

                <p class="sub-text">
                    Nhập mã nhân viên đã đăng ký
                </p>

                @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { id = "forgotPasswordForm" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label>Mã nhân viên</label>

                        <div class="input-box">
                            <i class="fa-solid fa-user"></i>

                            @Html.TextBoxFor(
                                m => m.EmployeeCD,
                                new
                                {
                                    placeholder = "Nhập mã nhân viên",
                                    autocomplete = "off"
                                }
                            )
                        </div>

                        @Html.ValidationMessageFor(
                            m => m.EmployeeCD,
                            "",
                            new { @class = "text-danger small" }
                        )
                    </div>

                    <button id="btnForgotPassword" class="btn-login" type="submit">
                        Gửi yêu cầu hỗ trợ
                    </button>

                    <div class="action-row forgot-action-row">
                        <a href="@Url.Action("Login", "Account")" class="btn btn-link">
                            <i class="fa-solid fa-arrow-left me-1"></i>
                            Quay lại đăng nhập
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        document.getElementById("forgotPasswordForm")
            .addEventListener("submit", function () {
                let btn = document.getElementById("btnForgotPassword");

                btn.disabled = true;
                btn.innerHTML =
                    '<i class="fa fa-spinner fa-spin"></i> Đang gửi yêu cầu...';
            });
    </script>

    <script>
        $(function () {
            var alert = @Html.Raw(Json.Encode(alert));

            if (alert && alert.Message) {
                toastr.options = {
                    "closeButton": true,
                    "progressBar": true,
                    "positionClass": "toast-top-right",
                    "timeOut": 5000
                };

                toastr[alert.Type](alert.Message);
            }
        });
    </script>
</body>
</html>
