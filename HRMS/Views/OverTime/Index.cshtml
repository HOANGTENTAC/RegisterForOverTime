@{
    ViewBag.Title = "Đăng ký tăng ca";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model HRMS.ViewModels.OverTimePageViewModel
<link href="~/CSS/over-time-index.css" rel="stylesheet" />
<link href="~/CSS/select2.min.css" rel="stylesheet" />
@using (Html.BeginForm("Create", "OverTime", FormMethod.Post,
    new
    {
        id = "OverTimeForm",
        data_confirm_message = ViewBag.ConfirmMessage
    }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" id="ForceSubmit" name="Request.ForceSubmit" value="false" />
    <div class="container-fluid">
        <div class="row g-4 mt-3">
            <!-- DANH SÁCH NHÂN VIÊN -->
            <div class="col-xl-5">
                <div class="card employee-card shadow-sm">
                    <div class="card-header bg-white">
                        <div class="section-title">
                            <i class="fa-solid fa-users"></i>
                            <h5 class="mb-0"> Nhân viên áp dụng </h5>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="department-list">
                            @{
                                int employeeIndex = 0;
                            }
                            @foreach (var group in Model.Employees.GroupBy(x => x.TenPhongBan))
                            {
                                <details class="dept-card">
                                    <summary class="dept-header">
                                        <div class="dept-left">
                                            <i class="fa-solid fa-sitemap"></i>
                                            <span>@group.Key</span>
                                        </div>
                                        <span class="dept-badge">
                                            @group.Count()
                                        </span>
                                    </summary>

                                    <div class="dept-content">
                                        <label class="select-all-row">
                                            <input type="checkbox" class="check-all-department">
                                            Chọn tất cả
                                        </label>

                                        @for (int i = 0; i < group.Count(); i++)
                                        {
                                            var nv = group.ElementAt(i);
                                            bool isChecked =
                                                Model.Request.EmployeeCDs != null &&
                                                Model.Request.EmployeeCDs.Any(e => e.MaNhanVien == nv.MaNhanVien);
                                            <label class="employee-row">
                                                <input type="checkbox"
                                                       class="employee-checkbox"
                                                       name="Request.EmployeeCDs[@employeeIndex].MaNhanVien"
                                                       value="@nv.MaNhanVien"
                                                       data-name="@nv.TenNhanVien"
                                                       data-code="@nv.MaNhanVien"
                                                       data-luuyke="@nv.MonthlyHours"
                                                       data-dept="@nv.MaPhongBan"
                                                       @(isChecked ? "checked=\"checked\"" : "") />
                                                <input type="hidden"
                                                       name="Request.EmployeeCDs[@employeeIndex].TenNhanVien"
                                                       value="@nv.TenNhanVien" />
                                                <span class="emp-info">
                                                    <span class="emp-code">@nv.MaNhanVien</span>
                                                    <span class="emp-name">@nv.TenNhanVien</span>
                                                </span>
                                            </label>
                                            employeeIndex++;
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- FORM -->
            <div class="col-xl-7">
                <div class="card ot-form-card shadow-sm">
                    <div class="card-header bg-white">
                        <div class="section-title">
                            <i class="fa-solid fa-clock"></i>
                            <h5 class="mb-0"> Thông tin tăng ca </h5>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label"> Ngày tăng ca</label>

                                @Html.TextBoxFor(m => m.Request.DateRequest, "{0:yyyy-MM-dd}",
                                    new
                                    {
                                        type = "date",
                                        id = "DateRequest",
                                        @class = "form-control",
                                        required = "required"
                                    })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">
                                    Loại ca (chỉ áp dụng khi ngày nghỉ)
                                </label>
                                <div class="shift-options">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="Request.OvertimeType" value="HanhChinh">
                                        <label class="form-check-label">
                                            Ca hành chính
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="Request.OvertimeType" value="Khac">
                                        <label class="form-check-label">
                                            Ca khác
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">
                                    Từ giờ
                                </label>

                                @Html.TextBoxFor(m => m.Request.FromTime, "{0:yyyy-MM-ddTHH:mm}",
                                    new
                                    {
                                        type = "datetime-local",
                                        id = "FromTime",
                                        @class = "form-control",
                                        required = "required"
                                    })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">
                                    Đến giờ
                                </label>
                                @Html.TextBoxFor(m => m.Request.ToTime, "{0:yyyy-MM-ddTHH:mm}",
                                    new
                                    {
                                        type = "datetime-local",
                                        id = "ToTime",
                                        @class = "form-control",
                                        required = "required"
                                    })
                            </div>
                            <div class="col-12">
                                <label class="form-label">
                                    Người xác nhận
                                    <span class="text-danger">*</span>
                                </label>
                                @{
                                    var approverGroups = Model.UserRoles
                                        .Where(x => !string.IsNullOrEmpty(x.MaNhanVien))
                                        .GroupBy(x => new
                                        {
                                            x.MaNhanVien,
                                            x.TenNhanVien
                                        })
                                        .Select(g => new
                                        {
                                            MaNhanVien = g.Key.MaNhanVien,
                                            TenNhanVien = g.Key.TenNhanVien,

                                            DepartmentCodes = g
                                                .Where(x => !string.IsNullOrEmpty(x.BoPhanQuanLy))
                                                .Select(x => x.BoPhanQuanLy)
                                                .Distinct()
                                                .ToList(),

                                            DepartmentNames = g
                                                .Where(x => !string.IsNullOrEmpty(x.TenPhongBan))
                                                .Select(x => x.TenPhongBan)
                                                .Distinct()
                                                .ToList()
                                        })
                                        .OrderBy(x => x.TenNhanVien)
                                        .ToList();
                                }

                                <select name="Request.ConfirmUserCD"
                                        id="ConfirmUserCD"
                                        class="form-select approve-select">
                                    <option value="">
                                        -- Chọn người xác nhận --
                                    </option>

                                    @foreach (var approver in approverGroups)
                                    {
                                        var deptCodes = string.Join("|", approver.DepartmentCodes);
                                        var deptText = approver.DepartmentNames.Any()
                                            ? string.Join(", ", approver.DepartmentNames)
                                            : "Chưa có bộ phận quản lý";

                                        <option value="@approver.MaNhanVien"
                                                data-depts="@deptCodes"
                                                @(approver.MaNhanVien == Model.Request.ConfirmUserCD ? "selected" : "")>
                                            @approver.TenNhanVien (@approver.MaNhanVien) - @deptText
                                        </option>
                                    }
                                </select>

                                <div id="confirmUserHint" class="text-danger small mt-2" style="display:none;">
                                    Không có người xác nhận phù hợp với bộ phận đã chọn.
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">
                                    Lý do
                                </label>
                                @Html.TextAreaFor(m => m.Request.Reason,
                                    new
                                    {
                                        rows = 3,
                                        @class = "form-control"
                                    })
                            </div>
                        </div>

                        <!-- SELECTED EMPLOYEE -->
                        <div class="selected-box">
                            <h4>
                                Nhân viên đã chọn
                            </h4>
                            <div id="empError" class="alert alert-danger m-3" style="display:none;">
                                ⚠ Bạn phải chọn ít nhất 1 nhân viên
                            </div>
                            <table class="selected-table">
                                <thead>
                                    <tr>
                                        <th>Mã nhân viên</th>
                                        <th>Tên nhân viên</th>
                                        <th>Lũy kế</th>
                                        <th width="70"></th>
                                    </tr>
                                </thead>
                                <tbody id="selectedBody">
                                    <tr class="empty-row">
                                        <td colspan="4" class="selected-empty">
                                            <i class="fa-regular fa-user"></i>
                                            <span>
                                                Chưa có nhân viên nào được chọn
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="text-end mt-4">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fa-solid fa-paper-plane me-2"></i>
                                Gửi duyệt
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script> window.checkDayOffUrl ='@Url.Action("CheckDayOff", "OverTime")';</script>
<script src="~/JS/attendance-report.js"></script>
<script src="~/JS/overtime-request.js"></script>
<script>
    $(function () {
        const $form = $('#OverTimeForm');
        const msg = $form.data('confirm-message');

        if (msg) {
            Swal.fire({
                title: 'Xác nhận',
                text: msg,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Có',
                cancelButtonText: 'Không'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#ForceSubmit').val('true');
                    $form.submit();
                }
            });
        }
    });
</script>
