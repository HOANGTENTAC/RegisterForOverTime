@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = ViewBag.Title ?? "Không tìm thấy";
    string title = ViewBag.ErrorTitle ?? "Không tìm thấy trang";
    string message = ViewBag.ErrorMessage ?? "Trang bạn đang truy cập không tồn tại hoặc không áp dụng cho tài khoản hiện tại.";
    string backUrl = ViewBag.BackUrl ?? Url.Action("Index", "Home");
    string backText = ViewBag.BackText ?? "Quay về trang chủ";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5">

            <div class="mb-4">
                <i class="fa-solid fa-circle-exclamation text-warning"
                   style="font-size:64px;"></i>
            </div>

            <h2 class="mb-3">
                @title
            </h2>

            <p class="text-muted mb-4" style="font-size:16px;">
                @message
            </p>

            <button type="button"
                    class="btn btn-primary px-4"
                    onclick="location.href='@backUrl'">
                <i class="fa-solid fa-arrow-left me-2"></i>
                @backText
            </button>

        </div>
    </div>
</div>